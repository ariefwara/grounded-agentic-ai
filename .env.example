# DeepSeek is only needed for documentation generation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# FAL image generation. The default endpoint is Z-Image Turbo LoRA.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/z-image/turbo/lora
FAL_TIMEOUT_MS=120000

# Runtime model configuration for the ADK engine.
# Use vertex for Google Cloud ADC or gemini for API-key based local runs.
LLM_PROVIDER=vertex
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# Gemini-specific aliases. These are used when LLM_PROVIDER=gemini or when
# GOOGLE_GENAI_USE_VERTEXAI=FALSE.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI configuration. Uses Google Application Default Credentials locally
# and the Cloud Run service account in deployment.
GCP_PROJECT=ariefwrz
VERTEX_LOCATION=global
VERTEX_TEXT_MODEL=gemini-2.5-flash

# Google ADK engine runtime configuration.
ADK_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ariefwrz
GOOGLE_CLOUD_LOCATION=global
