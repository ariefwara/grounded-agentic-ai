# DeepSeek is only needed for documentation generation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# FAL image generation. The default endpoint is Z-Image Turbo LoRA.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/z-image/turbo/lora
FAL_TIMEOUT_MS=120000

# Runtime LLM configuration for the engine.
# Supported providers: off, mock, openai, openai-compatible, deepseek, gemini, vertex.
LLM_PROVIDER=vertex
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# Gemini-specific aliases. These are used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI configuration. Uses `gcloud auth print-access-token`.
GCP_PROJECT=ariefwrz
VERTEX_LOCATION=global
VERTEX_TEXT_MODEL=gemini-2.5-flash

# Gate configuration. Use off/skipped values only for development or simulation.
GATE_SEMANTIC_QUESTION_MATCH=on
GATE_INFORMATION_CLASSIFICATION=on
GATE_INFORMATION_ELIGIBILITY=on
GATE_ACTION_ELIGIBILITY=on
GATE_ANSWER_BOUNDARY=on
GATE_LLM_RESPONSE=on
GATE_RESPONSE_EVALUATION=on
