---
import { docGroups } from "../lib/docs.js";
import "../styles/global.css";

const { activeSlug, title } = Astro.props;
const docsPath = (slug) => `${import.meta.env.BASE_URL}docs/${slug}`.replace(/\/{2,}/g, "/");
const siteTitle = "AI Customer Service Engine";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AI Customer Service Engine documentation by Arief Warazuhudien" />
    <title>{title} | {siteTitle}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={docsPath("product-scope")}>
        <span class="brand-mark">AI</span>
        <span>{siteTitle}</span>
      </a>
      <button class="menu-button" type="button" aria-label="Toggle navigation" data-menu-button>
        <span></span><span></span><span></span>
      </button>
    </header>

    <div class="page-shell">
      <aside class="sidebar" data-sidebar>
        <nav aria-label="Documentation navigation">
          {
            docGroups.map((group) => (
              <section class="nav-group">
                <h2>{group.title}</h2>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a class:list={{ active: item.slug === activeSlug }} href={docsPath(item.slug)}>
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </nav>
      </aside>

      <main class="content">
        <article class="doc-content">
          <slot />
        </article>
        <footer class="doc-footer">
          <p>
            Created by <strong>Arief Warazuhudien</strong>.
            Visit <a href="https://www.ariefw.com" rel="noreferrer">ariefw.com</a>
            or contact via <a href="https://my.linkedin.com/in/ariefwara" rel="noreferrer">LinkedIn</a>.
          </p>
        </footer>
      </main>
    </div>

    <script>
      import mermaid from "mermaid";

      const menuButton = document.querySelector("[data-menu-button]");
      const sidebar = document.querySelector("[data-sidebar]");
      menuButton?.addEventListener("click", () => sidebar?.classList.toggle("open"));

      mermaid.initialize({
        startOnLoad: false,
        theme: "neutral",
        securityLevel: "strict",
      });

      const sourceBlocks = document.querySelectorAll("pre code.language-mermaid");
      const diagrams = [];
      for (const sourceBlock of sourceBlocks) {
        const container = document.createElement("div");
        container.className = "mermaid";
        container.textContent = sourceBlock.textContent;
        sourceBlock.parentElement?.replaceWith(container);
        diagrams.push(container);
      }

      void mermaid.run({ nodes: diagrams }).catch((error) => console.error("Unable to render Mermaid diagrams.", error));
    </script>
  </body>
</html>
