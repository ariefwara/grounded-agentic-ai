---
const target = `${import.meta.env.BASE_URL}docs/product-scope`.replace(/\/{2,}/g, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>AI Customer Service Engine</title>
  </head>
  <body>
    <a href={target}>Open documentation</a>
  </body>
</html>
